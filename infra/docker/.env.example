# Compose interpolation only: copy to infra/docker/.env.local, then fill secrets.
# Generate independent random values and retain the required mpg-/mpk- prefixes.
MP_ACCESS_TOKEN=
MP_BOOTSTRAP_KEY=
ADMIN_PIN=
# Optional operator credential; environment changes do not revoke persisted keys.
# MP_MANAGEMENT_KEY=mpk-REPLACE_WITH_UNIQUE_SECRET
# Host port defaults to automatic allocation on 127.0.0.1.
# PUBLISHED_PORT=3000
# BACKUPS_ROOT=/data/backups
# UniFi: local controller uses HOST; cloud uses CONSOLE_ID. SITE_ID is a UUID.
# UNIFI_API_KEY=REPLACE_WITH_UNIQUE_SECRET
# UNIFI_SITE_ID=REPLACE_WITH_SITE_UUID
# UNIFI_HOST=https://controller.example
# UNIFI_CONSOLE_ID=REPLACE_WITH_CONSOLE_ID
# TLS verification is enabled; use 1 only for an explicitly trusted test controller.
# UNIFI_TLS_INSECURE=0
# WEATHER_ENABLED=1
# WEATHER_ENDPOINT=https://provider.example/weather
# QUOTE_ENDPOINT=https://provider.example/quote
# ONTHISDAY_ENDPOINT=https://provider.example/onthisday
