# Copy this file to .env.local and replace the example values for local development.
# Exported shell variables take precedence over values in .env.local.
MP_ACCESS_TOKEN=mpg-local-change-me
MP_BOOTSTRAP_KEY=mpk-local-bootstrap-change-me
MP_MANAGEMENT_KEY=mpk-local-management-change-me
ADMIN_PIN=1234

# Localhost-only UI convenience. Leave unset or 0 to keep the long-press and PIN flow.
VITE_DEV_BYPASS_ADMIN_PIN=0
