# Copy to .env.local. These are synthetic local examples; replace credentials.
# Exported shell variables take precedence. npm run dev allocates two real ports.
HOST=127.0.0.1
PORT=0
WEB_PORT=0
DATA_DIR=.data
DATABASE_PATH=marplanner.db
MP_ACCESS_TOKEN=mpg-local-change-me
MP_BOOTSTRAP_KEY=mpk-local-bootstrap-change-me
MP_ADMIN_PIN=1234

# Optional management credential. Changing it does not revoke persisted credentials.
# MP_MANAGEMENT_KEY=mpk-local-management-change-me
# BACKUPS_ROOT=.data/backups
# BASE_PATH=/family/planner # Built deployment only; leave unset for npm run dev.

# Keep the long-press and PIN flow enabled.
VITE_DEV_BYPASS_ADMIN_PIN=0

# Dedicated DEV Chrome profile for session helpers (not used in production).
# CHROME_CDP_PORT=9222
# CHROME_USER_DATA_DIR=.data/chrome-cdp
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Canonical dir of gitignored seed*-PRIVATE.* for worktree sync (optional).
# Default: primary git worktree seeds/. Example absolute path to main checkout seeds/.
# MP_PRIVATE_SEEDS_DIR=

# Optional integrations. Leave absent settings commented to preserve defaults.
# UNIFI_API_KEY=replace-me
# UNIFI_SITE_ID=replace-me
# UNIFI_HOST=https://controller.example
# UNIFI_CONSOLE_ID=replace-me
# UNIFI_TLS_INSECURE=0
# WEATHER_ENABLED=1
# WEATHER_ENDPOINT=https://weather.example
# QUOTE_ENDPOINT=https://quote.example
# ONTHISDAY_ENDPOINT=https://history.example
# SCHEDULER_DISABLED=1
