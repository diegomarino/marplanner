{
  "name": "marplanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marplanner household planning application",
  "license": "MIT",
  "author": "Marplanner contributors",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "11.19.0"
  },
  "scripts": {
    "build": "npm run check:plugin-events && vite build && node scripts/build-server.mjs",
    "check:accessible-names": "node tools/dev/audit-accessible-names.mjs --strict-weak --check-baseline tools/dev/accessible-names-baseline.txt",
    "check:aggregate-only": "npm run check:preflight:browser && npm run build && node tools/dev/smoke-dist-render.mjs && npm run test:cohorts:e2e:list && npm run test:cohorts:e2e && npm run check:test-cohorts",
    "check:container": "node tools/container-smoke.mjs",
    "check:coverage": "node tools/verify-coverage.mjs --expected tests/fixtures/assembly-cohort.json --coverage-final coverage/coverage-final.json --candidate \"$MP_CANDIDATE_ID\"",
    "check:exception-list": "node tools/dev/check-exception-list.mjs --base \"${MP_ACCEPTED_PREDECESSOR:-11b6a7d94c571e1551bafcf53e9edb0ce3f96ef5}\"",
    "check:fast": "npm run format:check && npm run check:member-colors && npm run check:noto-emojis && npm run typecheck && npm run lint && npm test && npm run test:unit",
    "check:full": "npm run check:standard && npm run check:aggregate-only",
    "check:member-colors": "node tools/dev/generate-member-colors.mjs --check",
    "check:noto-emojis": "node tools/dev/generate-noto-emojis.mjs --check",
    "check:openapi-bodies": "node tools/api-contract-audit/audit.mjs --product .",
    "check:openapi-shapes": "node tools/check-openapi-drift.mjs --shapes",
    "check:openapi": "node tools/check-openapi-drift.mjs",
    "check:preflight:browser": "node tools/verify-coverage.mjs --preflight-browser --expected tests/fixtures/assembly-cohort.json --candidate \"$MP_CANDIDATE_ID\" && npm run check:coverage && npm run check:test-cohorts:standard",
    "check:preflight": "node tools/verify-coverage.mjs --preflight --expected tests/fixtures/assembly-cohort.json --candidate \"$MP_CANDIDATE_ID\"",
    "check:standard": "npm run check:preflight && npm run test:cohorts:stamp && npm run format:check && npm run check:ui-catalog && npm run check:member-colors && npm run check:noto-emojis && npm run typecheck && npm run lint && npm run build && npm run test:cohorts:node && npm run test:cohorts:vitest:list && npm run test:cohorts:vitest && npm run check:openapi && npm run check:openapi-shapes && npm run check:ui-debt && npm run check:exception-list && npm run check:accessible-names && npm run check:coverage && npm run check:test-cohorts:standard",
    "check:test-cohorts:standard": "node tools/verify-test-cohorts.mjs --expected tests/fixtures/assembly-cohort.json --raw-dir .quality --candidate \"$MP_CANDIDATE_ID\" --runners node,vitest",
    "check:test-cohorts": "node tools/verify-test-cohorts.mjs --expected tests/fixtures/assembly-cohort.json --raw-dir .quality --candidate \"$MP_CANDIDATE_ID\"",
    "check:ui-catalog": "node tools/dev/generate-ui-catalog.mjs --check",
    "check:ui-debt": "node tools/dev/count-ui-debt.mjs",
    "dev:chrome": "node tools/dev/chrome-cdp.mjs",
    "docs:screenshots": "node tools/docs/capture-screenshots.mjs",
    "dev:fresh": "node tools/dev/fresh-local.mjs",
    "dev:server": "node --env-file-if-exists=.env.local --import tsx --watch src/server/index.ts",
    "dev:session": "node tools/dev/browser-session.mjs",
    "dev:session-reset": "node tools/dev/browser-reset.mjs",
    "dev:unifi-fixture": "node --import tsx tools/dev/unifi-fixture.ts",
    "dev": "node tools/dev/start-local.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "generate:member-colors": "node tools/dev/generate-member-colors.mjs",
    "generate:noto-emojis": "node tools/dev/generate-noto-emojis.mjs",
    "generate:openapi": "node tools/generate-openapi.mjs",
    "generate:ui-catalog": "node tools/dev/generate-ui-catalog.mjs",
    "lint": "npm run check:plugin-events && node tools/lint.mjs",
    "devices": "node --env-file-if-exists=.env.local --import tsx src/server/auth/devices-cli.ts",
    "seed:all": "node tools/dev/seed-all.mjs",
    "seed:private": "node --env-file-if-exists=.env.local --import tsx src/server/db/seeds/cli.ts --mode private",
    "seed:public": "node --env-file-if-exists=.env.local --import tsx src/server/db/seeds/cli.ts --mode public",
    "seed:sync-private": "node tools/dev/sync-private-seeds.mjs",
    "seed": "node tools/dev/seed-all.mjs",
    "start": "node --env-file-if-exists=.env.local dist/server/index.js",
    "test:api-contract-audit": "node tools/api-contract-audit/audit.test.mjs .",
    "test:boundary": "vitest run tests/boundary --environment node",
    "test:cohorts:e2e:list": "playwright test --list --reporter=json > .quality/playwright-list.json",
    "test:cohorts:e2e": "playwright test",
    "test:cohorts:node": "node --test --test-reporter=junit tools/*.test.mjs > .quality/node-results.xml",
    "test:cohorts:stamp": "node tools/candidate-identity.mjs --stamp",
    "test:cohorts:vitest:list": "vitest list tests/client tests/boundary tests/integration --json > .quality/vitest-list.json",
    "test:cohorts:vitest": "vitest run tests/client tests/boundary tests/integration --coverage --reporter=json --outputFile=.quality/vitest-results.json",
    "test:coverage": "vitest run tests/client tests/boundary tests/integration --coverage",
    "test:e2e": "playwright test",
    "test:e2e:time-announcements": "MP_E2E_TIME_ANNOUNCEMENTS=1 playwright test tests/e2e/time-announcements.spec.ts",
    "test:integration": "vitest run tests/integration --environment node",
    "test:unit": "vitest run tests/client",
    "test": "node --test tools/*.test.mjs",
    "typecheck": "tsc -b",
    "check:plugin-events": "node tools/check-plugin-events.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "9.9.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@scalar/fastify-api-reference": "1.72.4",
    "@schedule-x/calendar": "^4.9.1",
    "@schedule-x/current-time": "^4.9.1",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.9.1",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.7",
    "lucide-react": "^1.56.0",
    "node-ical": "0.27.3",
    "pngjs": "7.0.0",
    "pressedslip": "0.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule": "2.8.1",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "0.3.2",
    "undici": "^8.11.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    },
    "pressedslip": {
      "zod": "$zod"
    }
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
