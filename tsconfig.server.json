{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "better-sqlite3"]
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "tests/boundary/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/helpers/**/*.ts"
  ]
}
